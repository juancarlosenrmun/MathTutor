{
  "name": "MathTutor",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "installNpm": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm install -g skills && ./scripts/install-skills.sh",
  "forwardPorts": [8080, 5432],
  "postStartCommand": "docker-compose up -d postgres",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "spring-boot.java-spring-boot",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.maven.userSettings": "/workspaces/.m2/settings.xml",
        "gradle.java.home": "/usr/lib/jvm/default-java"
      }
    }
  },
  "remoteUser": "vscode"
}