# Configuración privada de cada dispositivo. Generar con: gradlew initLocalEnv
# No versionar .env. Usar valores simples sin comillas ni barras invertidas.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mathtutor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
JWT_SECRET=

# Obtener la clave en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_AI_CHAT_MODEL=gemini-2.5-flash
GOOGLE_AI_MAX_REQUESTS_PER_MINUTE=5
