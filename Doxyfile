                        mathtutor-auth/src/main/java \
                        mathtutor-cas/src/main/java \
                        mathtutor-tutor/src/main/java \
                        mathtutor-llm/src/main/java \
                        mathtutor-persistence/src/main/java \
                        mathtutor-application/src/main/java \
                        mathtutor-graphics/src/main/java \
                        mathtutor-graphics/src/main/resources/static/visor
FILE_PATTERNS         = *.java *.mjs
EXTENSION_MAPPING     = mjs=JavaScript
RECURSIVE             = YES
INPUT_ENCODING        = UTF-8
