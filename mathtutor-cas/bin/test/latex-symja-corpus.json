          "expectedEquivalent": "Csc[x]"
        },
        {
          "id": "trig_08",
          "latex": "Cot[x]",
          "symja": "Cot[x]",
          "expectedEquivalent": "Cot[x]"
        }
      ],
      "negatives": [
        {
          "id": "trig_neg_01",
          "latex": "Sin[x]",
          "notEquivalentTo": "Cos[x]"
        },
        {
          "id": "trig_neg_02",
          "latex": "Sin[x]^2",
          "notEquivalentTo": "Cos[x]^2"
        }
      ]
