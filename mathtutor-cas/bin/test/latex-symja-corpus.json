{
  "version": "1.0",
  "description": "Corpus de casos LaTeX → Symja para validación de conversión y equivalencia",
  "categories": {
    "derivatives": {
      "description": "Derivadas básicas y compuestas",
      "cases": [
        {
          "id": "deriv_01",
          "latex": "x^2",
          "symja": "x^2",
          "expectedEquivalent": "x^2"
        },
        {
          "id": "deriv_02",
          "latex": "2*x",
          "symja": "2*x",
          "expectedEquivalent": "2*x"
        },
        {
          "id": "deriv_03",
          "latex": "Cos[x]",
          "symja": "Cos[x]",
          "expectedEquivalent": "Cos[x]"
        },
        {
          "id": "deriv_04",
          "latex": "Exp[x]",
          "symja": "Exp[x]",
          "expectedEquivalent": "Exp[x]"
        },
        {
          "id": "deriv_05",
          "latex": "1/x",
          "symja": "1/x",
          "expectedEquivalent": "1/x"
        },
        {
          "id": "deriv_06",
          "latex": "(x+1)^2",
          "symja": "(x+1)^2",
          "expectedEquivalent": "x^2+2*x+1"
        },
        {
          "id": "deriv_07",
          "latex": "3*x^2+2",
          "symja": "3*x^2+2",
          "expectedEquivalent": "3*x^2+2"
        },
        {
          "id": "deriv_08",
          "latex": "1/(2*Sqrt[x])",
          "symja": "1/(2*Sqrt[x])",
          "expectedEquivalent": "1/(2*Sqrt[x])"
        }
      ],
      "negatives": [
        {
          "id": "deriv_neg_01",
          "latex": "x^2",
          "notEquivalentTo": "x^3"
        },
        {
          "id": "deriv_neg_02",
          "latex": "Sin[x]",
          "notEquivalentTo": "Cos[x]"
        },
        {
          "id": "deriv_neg_03",
          "latex": "2*x",
          "notEquivalentTo": "3*x"
        }
      ]
    },
    "integrals": {
      "description": "Integrales indefinidas y definidas",
      "cases": [
        {
          "id": "int_01",
          "latex": "x^2/2",
          "symja": "x^2/2",
          "expectedEquivalent": "x^2/2"
        },
        {
          "id": "int_02",
          "latex": "x^3/3",
          "symja": "x^3/3",
          "expectedEquivalent": "x^3/3"
        },
        {
          "id": "int_03",
          "latex": "-Cos[x]",
          "symja": "-Cos[x]",
          "expectedEquivalent": "-Cos[x]"
        },
        {
          "id": "int_04",
          "latex": "Exp[x]",
          "symja": "Exp[x]",
          "expectedEquivalent": "Exp[x]"
        },
        {
          "id": "int_05",
          "latex": "Log[x]",
          "symja": "Log[x]",
          "expectedEquivalent": "Log[x]"
        },
        {
          "id": "int_06",
          "latex": "1/3",
          "symja": "1/3",
          "expectedEquivalent": "1/3"
        },
        {
          "id": "int_07",
          "latex": "2",
          "symja": "2",
          "expectedEquivalent": "2"
        },
        {
          "id": "int_08",
          "latex": "Sin[x]-x*Cos[x]",
          "symja": "Sin[x]-x*Cos[x]",
          "expectedEquivalent": "Sin[x]-x*Cos[x]"
        }
      ],
      "negatives": [
        {
          "id": "int_neg_01",
          "latex": "x^2/2",
          "notEquivalentTo": "x^2"
        },
        {
          "id": "int_neg_02",
          "latex": "Sin[x]",
          "notEquivalentTo": "Cos[x]"
        }
      ]
    },
    "powers": {
      "description": "Potencias y reglas de exponentes",
      "cases": [
        {
          "id": "pow_01",
          "latex": "(x^2)^3",
          "symja": "(x^2)^3",
          "expectedEquivalent": "x^6"
        },
        {
          "id": "pow_02",
          "latex": "x^2*x^3",
          "symja": "x^2*x^3",
          "expectedEquivalent": "x^5"
        },
        {
          "id": "pow_03",
          "latex": "x^5/x^2",
          "symja": "x^5/x^2",
          "expectedEquivalent": "x^3"
        },
        {
          "id": "pow_04",
          "latex": "x^(-2)",
          "symja": "x^(-2)",
          "expectedEquivalent": "1/x^2"
        },
        {
          "id": "pow_05",
          "latex": "x^(1/2)",
          "symja": "x^(1/2)",
          "expectedEquivalent": "x^(1/2)"
        },
        {
          "id": "pow_06",
          "latex": "(2*x)^3",
          "symja": "(2*x)^3",
          "expectedEquivalent": "8*x^3"
        },
        {
          "id": "pow_07",
          "latex": "x^0",
          "symja": "x^0",
          "expectedEquivalent": "1"
        },
        {
          "id": "pow_08",
          "latex": "x^(1/3)",
          "symja": "x^(1/3)",
          "expectedEquivalent": "x^(1/3)"
        }
      ],
      "negatives": [
        {
          "id": "pow_neg_01",
          "latex": "x^2",
          "notEquivalentTo": "x^3"
        },
        {
          "id": "pow_neg_02",
          "latex": "x^2*x^3",
          "notEquivalentTo": "x^6"
        }
      ]
    },
    "roots": {
      "description": "Raíces y radicales",
      "cases": [
        {
          "id": "root_01",
          "latex": "Sqrt[x]",
          "symja": "Sqrt[x]",
          "expectedEquivalent": "Sqrt[x]"
        },
        {
          "id": "root_02",
          "latex": "Sqrt[x^2]",
          "symja": "Sqrt[x^2]",
          "expectedEquivalent": "Sqrt[x^2]"
        },
        {
          "id": "root_03",
          "latex": "Sqrt[4*x^2]",
          "symja": "Sqrt[4*x^2]",
          "expectedEquivalent": "Sqrt[4*x^2]"
        },
        {
          "id": "root_04",
          "latex": "(x^3)^(1/3)",
          "symja": "(x^3)^(1/3)",
          "expectedEquivalent": "(x^3)^(1/3)"
        },
        {
          "id": "root_05",
          "latex": "Sqrt[x]*Sqrt[y]",
          "symja": "Sqrt[x]*Sqrt[y]",
          "expectedEquivalent": "Sqrt[x]*Sqrt[y]"
        },
        {
          "id": "root_06",
          "latex": "Sqrt[x]/Sqrt[y]",
          "symja": "Sqrt[x]/Sqrt[y]",
          "expectedEquivalent": "Sqrt[x]/Sqrt[y]"
        },
        {
          "id": "root_07",
          "latex": "Sqrt[a^2+b^2]",
          "symja": "Sqrt[a^2+b^2]",
          "expectedEquivalent": "Sqrt[a^2+b^2]"
        },
        {
          "id": "root_08",
          "latex": "x^(1/2)",
          "symja": "x^(1/2)",
          "expectedEquivalent": "x^(1/2)"
        }
      ],
      "negatives": [
        {
          "id": "root_neg_01",
          "latex": "Sqrt[x]",
          "notEquivalentTo": "Sqrt[-x]"
        },
        {
          "id": "root_neg_02",
          "latex": "Sqrt[x^2]",
          "notEquivalentTo": "x"
        }
      ]
    },
    "trigonometric": {
      "description": "Funciones trigonométricas e identidades",
      "cases": [
